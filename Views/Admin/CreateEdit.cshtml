@model WebApplication2.Models.VideojuegoViewModel
@{
    var isEdit = Model?.Id > 0;
    ViewData["Title"] = isEdit ? "Editar videojuego" : "Nuevo videojuego";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Admin" asp-action="Save" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Género</label>
            <input asp-for="Genero" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Plataforma</label>
            <input asp-for="Plataforma" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Precio</label>
            <input asp-for="Precio" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Imagen URL</label>
        <input asp-for="ImagenUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Stock</label>
        <input asp-for="Stock" class="form-control" />
    </div>

    <button class="btn btn-primary">Guardar</button>
    <a asp-controller="Admin" asp-action="Inventory" class="btn btn-link">Cancelar</a>
</form>