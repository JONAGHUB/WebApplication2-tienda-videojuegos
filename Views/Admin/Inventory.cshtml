@model IEnumerable<WebApplication2.Models.VideojuegoViewModel>
@{
    ViewData["Title"] = "Inventario (Admin)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Inventario</h1>
    <a asp-controller="Admin" asp-action="Create" class="btn btn-primary">Nuevo videojuego</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Título</th>
            <th>Plataforma</th>
            <th>Stock</th>
            <th>Precio</th>
            <th>Coste adquisición</th>
            <th>Coste reposición</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var it in Model)
        {
            <tr>
                <td>@it.Titulo</td>
                <td>@it.Plataforma</td>
                <td>@it.Stock</td>
                <td>@it.Precio.ToString("C")</td>
                <td>@( (it.Precio * 0.6m).ToString("C") )</td>
                <td>@( (it.Precio * 0.2m).ToString("C") )</td>
                <td class="text-end">
                    <a asp-controller="Admin" asp-action="Edit" asp-route-id="@it.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                    <form asp-controller="Admin" asp-action="Restock" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@it.Id" />
                        <input type="number" name="cantidad" value="10" min="1" class="form-control d-inline-block w-auto" />
                        <button class="btn btn-sm btn-success">Reponer</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>