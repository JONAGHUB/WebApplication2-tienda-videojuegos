@model List<WebApplication2.Models.CartItem>
@{
    ViewData["Title"] = "Carrito";
    var username = User?.Identity?.IsAuthenticated == true ? User.Identity.Name : "Invitado";
    decimal total = Model.Sum(i => i.Precio * i.Cantidad);
}

<h1>Carrito</h1>

<div class="mb-3 text-end text-muted">Usuario: <strong>@username</strong></div>

@if (!Model.Any())
{
    <div class="alert alert-info">Tu carrito está vacío. <a asp-controller="Games" asp-action="Index">Ir a la tienda</a>.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Juego</th>
                <th>Precio</th>
                <th>Cantidad</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titulo</td>
                    <td>@item.Precio.ToString("C")</td>
                    <td>@item.Cantidad</td>
                    <td>@(item.Precio * item.Cantidad).ToString("C")</td>
                    <td>
                        <form asp-controller="Cart" asp-action="Remove" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.VideojuegoId" />
                            <button class="btn btn-sm btn-outline-danger">Quitar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-end align-items-center gap-3">
        <div class="fs-5">Total: <strong>@total.ToString("C")</strong></div>
        <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary">Finalizar compra</a>
    </div>
}