@model IEnumerable<WebApplication2.Models.VideojuegoViewModel>
@{
    ViewData["Title"] = "Pago";
}

<h1>Finalizar compra</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Checkout" asp-action="Confirm" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Nombre completo</label>
                <input name="nombre" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Dirección de facturación</label>
                <input name="direccion" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Método de pago</label>
                <select name="metodo" class="form-select">
                    <option>Tarjeta</option>
                    <option>PayPal</option>
                </select>
            </div>

            <button type="submit" class="btn btn-success">Pagar</button>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-link">Volver al carrito</a>
        </form>
    </div>

    <div class="col-md-6">
        <h5>Resumen</h5>
        <ul class="list-group">
            @foreach (var item in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @item.Titulo
                    <span>@item.Precio.ToString("C")</span>
                </li>
            }
        </ul>
    </div>
</div>