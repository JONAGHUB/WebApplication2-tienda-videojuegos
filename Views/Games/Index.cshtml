@model IEnumerable<WebApplication2.Models.VideojuegoViewModel>
@{
    ViewData["Title"] = "Tienda";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string query = ViewBag.Query ?? string.Empty;
    int pageSize = ViewBag.PageSize ?? 12;
}

<div class="mb-4">
    <div id="storeCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{
                var featured = Model.Take(3).ToList();
                for (int i = 0; i < featured.Count; i++)
                {
                    var f = featured[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="d-flex align-items-center p-4 bg-dark text-white rounded" style="min-height:260px;">
                            <img src="@f.ImagenUrl" class="me-4 rounded" style="height:200px; width:320px; object-fit:cover" alt="@f.Titulo" />
                            <div>
                                <h3>@f.Titulo</h3>
                                <p class="text-muted">@f.Genero — @f.Plataforma</p>
                                <p class="lead text-warning">@f.Precio.ToString("C")</p>
                                <p class="mb-0 text-truncate" style="max-width:600px;">@f.Descripcion</p>
                                <a asp-controller="Games" asp-action="Details" asp-route-id="@f.Id" class="btn btn-primary mt-2">Ver ficha</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#storeCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#storeCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Tienda</h1>

    <form class="d-flex" method="get" asp-action="Index">
        <input type="hidden" name="pageSize" value="@pageSize" />
        <input class="form-control me-2" type="search" name="q" value="@query" placeholder="Buscar título, género..." />
        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
    </form>
</div>

<div class="row g-3">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            @await Html.PartialAsync("_GameCard", item)
        </div>
    }
</div>

<nav class="mt-4" aria-label="Paginación">
    <ul class="pagination justify-content-center">
        <li class="page-item @(page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page-1)" asp-route-q="@query" asp-route-pageSize="@pageSize">«</a>
        </li>

        @for (int p = 1; p <= totalPages; p++)
        {
            <li class="page-item @(p == page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-q="@query" asp-route-pageSize="@pageSize">@p</a>
            </li>
        }

        <li class="page-item @(page >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(page+1)" asp-route-q="@query" asp-route-pageSize="@pageSize">»</a>
        </li>
    </ul>
</nav>

