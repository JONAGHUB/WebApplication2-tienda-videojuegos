@model WebApplication2.Models.VideojuegoViewModel

@{
    var videoId = string.Empty;
    if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
    {
        var uri = Model.VideoUrl;
        if (uri.Contains("youtu.be/"))
        {
            videoId = uri.Split("youtu.be/").Last().Split('?').First();
        }
        else if (uri.Contains("v="))
        {
            videoId = uri.Split("v=").Last().Split('&').First();
        }
        else if (uri.Contains("embed/"))
        {
            videoId = uri.Split("embed/").Last().Split('?').First();
        }
    }
    var modalId = $"videoModal{Model.Id}";
}

<div class="card game-card h-100 shadow-sm">
    <div class="position-relative">
        <img src="@Model.ImagenUrl" class="card-img-top" alt="@Model.Titulo" style="height:160px;object-fit:cover" />
        @if (Model.Stock <= 0)
        {
            <span class="badge bg-danger position-absolute top-0 end-0 m-2">Agotado</span>
        }
        else if (Model.Stock < 10)
        {
            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Pocas unidades</span>
        }

        @if (!string.IsNullOrEmpty(videoId))
        {
            <button type="button"
                    class="btn btn-light rounded-circle position-absolute top-50 start-50 translate-middle shadow"
                    style="width:48px;height:48px;opacity:0.9"
                    data-bs-toggle="modal"
                    data-bs-target="#@modalId"
                    title="Ver gameplay">
                <span style="font-size:1.3rem">▶</span>
            </button>
        }
    </div>

    <div class="card-body d-flex flex-column">
        <h6 class="card-title mb-1 text-truncate" title="@Model.Titulo">@Model.Titulo</h6>
        <small class="text-muted">@Model.Genero · @Model.Plataforma</small>

        <div class="mt-1 mb-1">
            @await Html.PartialAsync("_StarRating", Model.PuntajePromedio)
        </div>

        <div class="mt-2 mb-2 d-flex justify-content-between align-items-center">
            <div class="fs-6 text-primary fw-semibold">@Model.Precio.ToString("C")</div>
            <div class="text-muted small">(@Model.Stock)</div>
        </div>

        <p class="text-truncate mb-3" style="max-height:3.2rem;">@Model.Descripcion</p>

        <div class="mt-auto d-flex justify-content-between align-items-center">
            <div class="d-flex gap-1">
                <a asp-controller="Games" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">Detalles</a>

                @if (!string.IsNullOrEmpty(videoId))
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#@modalId">
                        ▶ Gameplay
                    </button>
                }
            </div>

            <form asp-controller="Cart" asp-action="Add" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="cantidad" value="1" />
                <button type="submit" class="btn btn-sm btn-primary" @(Model.Stock <= 0 ? "disabled" : "")>Comprar</button>
            </form>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(videoId))
{
    <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@(modalId)Label" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="@(modalId)Label">@Model.Titulo — Gameplay</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="ratio ratio-16x9">
                        <iframe src="https://www.youtube.com/embed/@videoId"
                                title="Gameplay de @Model.Titulo"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
}