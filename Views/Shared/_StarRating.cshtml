@model double
@{
    int filled = (int)Math.Round(Model);
    if (filled < 0) filled = 0;
    if (filled > 5) filled = 5;
}
<div class="star-rating" aria-label="Puntuación media: @Model">
    @for (int i = 1; i <= 5; i++)
    {
        if (i <= filled)
        {
            <span class="me-1 text-warning" style="font-size:1.1rem">★</span>
        }
        else
        {
            <span class="me-1 text-muted" style="font-size:1.1rem">☆</span>
        }
    }
    <small class="text-muted ms-2">(@Model.ToString("0.0"))</small>
</div>